+static void jsonString(FILE *f, const char *s) {
+  fputc('"', f);
+  for (; *s; s++) {
+    unsigned char c = (unsigned char)*s;
+    if (c == '"' || c == '\\') fprintf(f, "\\%c", c);
+    else if (c < 0x20) fprintf(f, "\\u%04x", c);
+    else fputc(c, f);
+  }
+  fputc('"', f);
+}
+
+void MyMesh::writePagerStatus(const char *path) {
+  char tmp[96];
+  snprintf(tmp, sizeof(tmp), "%s.tmp", path);
+  FILE *f = fopen(tmp, "w");
+  if (!f) return;
+  char key[PUB_KEY_SIZE * 2 + 1];
+  for (int i = 0; i < PUB_KEY_SIZE; i++) snprintf(&key[i * 2], 3, "%02x", self_id.pub_key[i]);
+  int channels = 0;
+  ChannelDetails ch;
+  for (int i = 0; i < MAX_GROUP_CHANNELS; i++) {
+    if (getChannel(i, ch) && ch.name[0]) channels++;
+  }
+  fprintf(f, "{\"name\":");
+  jsonString(f, _prefs.node_name);
+  fprintf(f, ",\"public_key\":\"%s\",\"freq\":%.3f,\"bw\":%.1f,\"sf\":%d,\"cr\":%d,\"tx_power\":%d,"
+             "\"uptime\":%lu,\"app_connected\":%s,\"contacts\":%d,\"max_contacts\":%d,\"channels\":%d,"
+             "\"queued\":%d,\"noise_floor\":%d,\"last_rssi\":%d,\"last_snr\":%.2f,"
+             "\"recv\":%lu,\"sent\":%lu,\"flood_rx\":%lu,\"direct_rx\":%lu,\"flood_tx\":%lu,\"direct_tx\":%lu,"
+             "\"recv_errors\":%lu,\"tx_air_secs\":%lu,\"battery_mv\":%u,\"updated\":%lu}\n",
+          key, _prefs.freq, _prefs.bw, _prefs.sf, _prefs.cr, _prefs.tx_power_dbm,
+          (unsigned long)(_ms->getMillis() / 1000), (_serial && _serial->isConnected()) ? "true" : "false",
+          getNumContacts(), MAX_CONTACTS, channels, offline_queue_len,
+          (int)_radio->getNoiseFloor(), (int)radio_driver.getLastRSSI(), radio_driver.getLastSNR(),
+          (unsigned long)radio_driver.getPacketsRecv(), (unsigned long)radio_driver.getPacketsSent(),
+          (unsigned long)getNumRecvFlood(), (unsigned long)getNumRecvDirect(),
+          (unsigned long)getNumSentFlood(), (unsigned long)getNumSentDirect(),
+          (unsigned long)radio_driver.getPacketsRecvErrors(), (unsigned long)(getTotalAirTime() / 1000),
+          (unsigned)board.getBattMilliVolts(), (unsigned long)getRTCClock()->getCurrentTime());
+  fclose(f);
+  rename(tmp, path);
+}
