@@ -61,13 +61,28 @@ public:
   void begin();
 
   uint16_t getBattMilliVolts() override {
+#ifdef PAGER_CH341
+    // Pineapple Pager fuel gauge (bq27546), microvolts.
+    FILE *f = fopen("/sys/class/power_supply/bq27546-0/voltage_now", "r");
+    long uv = 0;
+    if (f) {
+      if (fscanf(f, "%ld", &uv) != 1) uv = 0;
+      fclose(f);
+    }
+    return (uint16_t)(uv / 1000);
+#else
     return 0;
+#endif
   }
 
   uint8_t getStartupReason() const override { return startup_reason; }
 
   const char* getManufacturerName() const override {
+#ifdef PAGER_CH341
+    return "WiFi Pineapple Pager";
+#else
     return "Linux";
+#endif
